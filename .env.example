CAREERPILOT_DATA_DIR=data
CAREERPILOT_FRONTEND_ORIGIN=http://127.0.0.1:9999
CAREERPILOT_PUBLIC_API_ORIGIN=http://127.0.0.1:9998

# In Docker, prefer *_FILE values mounted read-only under /run/secrets.
# Never commit the referenced files or put real credentials in this example.
# CAREERPILOT_MAIL_SECRET_FILE=/run/secrets/mail
# CAREERPILOT_MODEL_SECRET_FILE=/run/secrets/model
# CAREERPILOT_TAVILY_SECRET_FILE=/run/secrets/tavily
# CAREERPILOT_SECRET_OAUTH_GMAIL_CLIENT_ID_FILE=/run/secrets/gmail-client-id
# CAREERPILOT_SECRET_OAUTH_GMAIL_CLIENT_SECRET_FILE=/run/secrets/gmail-client-secret
# CAREERPILOT_SECRET_OAUTH_OUTLOOK_CLIENT_ID_FILE=/run/secrets/outlook-client-id
# CAREERPILOT_SECRET_OAUTH_OUTLOOK_CLIENT_SECRET_FILE=/run/secrets/outlook-client-secret
